# Copy to ".env" next to docker-compose.yml:   cp .env.example .env

# REQUIRED - at least 32 random characters. Generate one with:
#   openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-0123456789

# Address(es) you open the app at, comma separated (must match WEB_PORT)
CLIENT_URL=http://localhost:8080,http://127.0.0.1:8080
WEB_PORT=8080

# Login created by the seed step
ADMIN_NAME=Hostel Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
# true = also create warden@example.com (Warden@123) and student@example.com (Student@123)
# Set to false for a real deployment
SEED_DEMO=true

# Optional
GEMINI_API_KEY=
CRON_SECRET=
# Use MongoDB Atlas instead of the bundled database:
# MONGO_URI=mongodb+srv://user:pass@cluster/hostel
