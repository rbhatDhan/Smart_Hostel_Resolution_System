# ---- Required ----
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/hostel?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars

# ---- Server ----
PORT=5000
NODE_ENV=development
# Comma separated list of frontend origins allowed by CORS + Socket.IO
CLIENT_URL=http://localhost:5173
JWT_EXPIRES_IN=1d
BCRYPT_ROUNDS=12
# Comma separated list of email domains allowed to self-register
ALLOWED_EMAIL_DOMAINS=gmail.com

# ---- AI (optional, features degrade gracefully without it) ----
GEMINI_API_KEY=
GEMINI_MODEL=

# ---- SLA monitoring ----
# In-process scheduler (works on Render/Railway/VPS/Docker, NOT on Vercel serverless)
ENABLE_CRON=true
SLA_CRON_SCHEDULE=*/10 * * * *
# Send an "SLA about to breach" alert this many minutes before the deadline
SLA_WARNING_MINUTES=120
# Protects GET/POST /api/cron/sla (for Vercel Cron, GitHub Actions, cron-job.org...)
CRON_SECRET=

# ---- Seeding (npm run seed) ----
ADMIN_NAME=Hostel Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
